        <AirspaceClass id="AS-Class-B" name="Class B"/>
        <AirspaceClass id="AS-Class-C" name="Class C"/>
        <AirspaceClass id="AS-Class-D" name="Class D"/>
        <AirspaceClass id="AS-Class-E" name="Class E"/>
      </AirspaceClasses>
      <SpecialUseAirspace>
