        <Property name="controllingAuthority"/>
        <Property name="verticalLimits"/>
        <Property name="lateralLimits"/>
        <Property name="entryConditions"/>
        <Property name="separationStandards"/>
        <Property name="communicationsRequirements"/>
      </CommonProperties>
    </Domain>

