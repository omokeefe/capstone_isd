<?xml version="1.0" encoding="UTF-8"?>
<ArchitectureModel name="National Airspace System as a System-of-Systems" version="0.1" modelingLanguage="SysML-inspired XML" purpose="Develop a SysML-based System-of-Systems architecture of the National Airspace System that models aircraft, airspace resources, air traffic management organizations, operational boundaries, and information exchanges.">
  <ModelIntent>
    <Statement>Represent the National Airspace System as a system-of-systems organized around authority, responsibility, lifecycle boundaries, operational interfaces, information ownership, and shared airspace resources.</Statement>
    <Statement>Model how strategic objectives propagate through airspace management, controllers, aircraft operations, flight deck decision making, aircraft systems, and vehicle dynamics.</Statement>
    <Statement>Demonstrate how advanced decision-support capabilities can be integrated into the architecture through representative optimization services.</Statement>
  </ModelIntent>

  <ArchitecturePrinciples>
    <Principle id="P001" name="Boundary Justification">
      <Description>Boundaries shall correspond to clear authority, responsibility, lifecycle, regulatory, or information-ownership boundaries rather than only conceptual categories.</Description>
    </Principle>
    <Principle id="P002" name="Airspace as Shared Resource">
      <Description>Airspace shall be modeled as a constrained, managed, shared resource used by multiple airspace users and controlled by responsible authorities.</Description>
    </Principle>
    <Principle id="P003" name="Intent Propagation">
      <Description>The architecture shall represent how strategic objectives become operational constraints, clearances, flight deck decisions, FMS intent, guidance commands, and aircraft motion.</Description>
    </Principle>
    <Principle id="P004" name="Decision Support as Service">
      <Description>Optimization and decision-support capabilities shall be modeled as services that integrate with operational domains rather than as the entire system of interest.</Description>
    </Principle>
  </ArchitecturePrinciples>

  <StakeholderAssessmentFramework name="PESTLE">
    <Category name="Political"/>
    <Category name="Economic"/>
    <Category name="Social"/>
    <Category name="Technical"/>
    <Category name="Legal"/>
    <Category name="Environmental"/>
  </StakeholderAssessmentFramework>

  <SystemOfInterest id="SOI-NAS" name="National Airspace System">
    <Description>A distributed system-of-systems composed of airspace users, aircraft, airspace resources, airports, air navigation service providers, regulatory bodies, information services, infrastructure, and decision-support capabilities.</Description>
  </SystemOfInterest>

  <TopLevelDomains>
    <Domain id="D-GOV" name="Governance Domain" boundaryBasis="regulatory authority; policy responsibility; certification authority">
      <Description>Defines rules, allocates authorities, certifies systems, investigates incidents, and governs NAS evolution.</Description>
      <Elements>
        <Element id="GOV-FAA" name="FAA" type="RegulatoryAuthority"/>
        <Element id="GOV-DOD" name="Department of Defense" type="GovernmentAuthority"/>
        <Element id="GOV-DHS" name="Department of Homeland Security" type="GovernmentAuthority"/>
        <Element id="GOV-NTSB" name="NTSB" type="InvestigationAuthority"/>
        <Element id="GOV-EASA" name="EASA" type="ForeignRegulatoryAuthority"/>
        <Element id="GOV-ICAO" name="ICAO" type="InternationalStandardsBody"/>
        <Element id="GOV-Airlines" name="Airlines" type="IndustryStakeholder"/>
        <Element id="GOV-AirportAuthorities" name="Airport Authorities" type="LocalAuthority"/>
        <Element id="GOV-Labor" name="Labor Organizations" type="StakeholderOrganization"/>
      </Elements>
      <Activities>
        <Activity id="ACT-GOV-001" name="Define Regulations"/>
        <Activity id="ACT-GOV-002" name="Define Procedures"/>
        <Activity id="ACT-GOV-003" name="Allocate Airspace"/>
        <Activity id="ACT-GOV-004" name="Certify Systems"/>
        <Activity id="ACT-GOV-005" name="Investigate Incidents"/>
      </Activities>
    </Domain>

    <Domain id="D-AIRSPACE-RESOURCE" name="Airspace Resource Domain" boundaryBasis="geographic limits; altitude limits; controlling authority; entry conditions; separation rules">
