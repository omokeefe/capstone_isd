  <RepresentativeUseCase id="UC-OPT-Rendezvous" name="Integrate Representative Optimization Service">
    <Description>Demonstrate how an optimization service, such as optimal rendezvous or trajectory optimization, receives objectives, constraints, aircraft state, airspace constraints, weather data, and operational rules, then produces advisory intent for human or automated decision processes.</Description>
    <ParticipatingDomains>
      <DomainRef ref="D-DECISION"/>
      <DomainRef ref="D-FLIGHT-OPS"/>
      <DomainRef ref="D-AIRSPACE-MGMT"/>
      <DomainRef ref="D-AIRSPACE-RESOURCE"/>
      <DomainRef ref="D-AIRCRAFT"/>
      <DomainRef ref="D-INFO"/>
    </ParticipatingDomains>
    <Inputs>
      <Input ref="IO-StrategicObjective"/>
      <Input ref="IO-MissionObjective"/>
      <Input ref="IO-AircraftState"/>
      <Input ref="IO-FuelStatus"/>
      <Input ref="IO-WeatherProduct"/>
      <Input ref="IO-Restriction"/>
      <Input ref="IO-AirspaceReservation"/>
    </Inputs>
    <Outputs>
      <Output ref="IO-TrajectoryIntent"/>
