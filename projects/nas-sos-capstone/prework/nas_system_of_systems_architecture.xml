        <Activity id="ACT-OPS-004" name="Mission Planning"/>
        <Activity id="ACT-OPS-005" name="Route Selection"/>
        <Activity id="ACT-OPS-006" name="Flight Monitoring"/>
        <Activity id="ACT-OPS-007" name="Diversion Planning"/>
        <Activity id="ACT-OPS-008" name="Advise on Route Modifications"/>
        <Activity id="ACT-OPS-009" name="Ensure Clear of Weather"/>
      </Activities>
    </Domain>

    <Domain id="D-AIRPORT" name="Airport Operations Domain" boundaryBasis="airport authority; surface movement responsibility; local resource management; ground service lifecycle">
