  <IntentPropagationThread id="THREAD-IntentToTrajectory" name="Intent-to-Trajectory Architecture">
    <Step order="1" sourceDomain="D-GOV" output="IO-StrategicObjective" name="Define Strategic Objective"/>
    <Step order="2" sourceDomain="D-FLIGHT-OPS" input="IO-StrategicObjective" output="IO-MissionPlan" name="Develop Mission or Flight Plan"/>
    <Step order="3" sourceDomain="D-FLIGHT-OPS" input="IO-MissionPlan" output="IO-FlightPlan" name="File or Negotiate Flight Plan"/>
    <Step order="4" sourceDomain="D-AIRSPACE-MGMT" input="IO-FlightPlan" output="IO-Restriction" name="Apply ATC and Flow Constraints"/>
    <Step order="5" sourceDomain="D-AIRSPACE-MGMT" input="IO-Restriction" output="IO-Clearance" name="Issue Clearance"/>
    <Step order="6" sourceDomain="D-AIRCRAFT" input="IO-Clearance" output="IO-FMSIntent" name="Modify Flight Deck and FMS Intent"/>
    <Step order="7" sourceDomain="D-AIRCRAFT" input="IO-FMSIntent" output="IO-GuidanceCommand" name="Generate Guidance Commands"/>
    <Step order="8" sourceDomain="D-AIRCRAFT" input="IO-GuidanceCommand" output="IO-AircraftState" name="Produce Aircraft Motion"/>
  </IntentPropagationThread>

  <ActivityResponsibilityTransitions id="ACTIVITY-FlightLifecycle" name="Flight Lifecycle Authority Transition">
    <Transition order="1" from="Ramp" to="Ground"/>
    <Transition order="2" from="Ground" to="Tower"/>
    <Transition order="3" from="Tower" to="Departure"/>
    <Transition order="4" from="Departure" to="Enroute"/>
    <Transition order="5" from="Enroute" to="Arrival"/>
    <Transition order="6" from="Arrival" to="Tower"/>
    <Transition order="7" from="Tower" to="Ground"/>
    <Transition order="8" from="Ground" to="Ramp"/>
  </ActivityResponsibilityTransitions>

