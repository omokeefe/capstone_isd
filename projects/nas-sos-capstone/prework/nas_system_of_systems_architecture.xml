        <ControlFunction id="CTRL-Ground" name="Ground Control"/>
        <ControlFunction id="CTRL-Local" name="Local Control"/>
        <ControlFunction id="CTRL-Departure" name="Departure Control"/>
        <ControlFunction id="CTRL-Arrival" name="Arrival Control"/>
        <ControlFunction id="CTRL-Enroute" name="Enroute Control"/>
