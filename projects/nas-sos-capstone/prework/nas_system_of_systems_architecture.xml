            <Role id="ROLE-AirlineMissionPlanner" name="Mission Planners"/>
            <Role id="ROLE-AirlineDispatcher" name="Dispatchers"/>
            <Role id="ROLE-AirlineFinance" name="Financiers"/>
          </Roles>
        </AirspaceUser>
        <AirspaceUser id="USER-Military" name="Military"/>
        <AirspaceUser id="USER-BusinessAviation" name="Business Aviation"/>
        <AirspaceUser id="USER-GeneralAviation" name="General Aviation"/>
        <AirspaceUser id="USER-UAS" name="UAS"/>
