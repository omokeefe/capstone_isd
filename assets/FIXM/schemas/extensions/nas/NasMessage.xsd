	<xs:import namespace="http://www.fixm.aero/base/4.3" schemaLocation="../../core/base/Base.xsd"/>
	<xs:import namespace="http://www.fixm.aero/app/msg/1.1" schemaLocation="../../applications/basicmessage/BasicMessage.xsd"/>
	<xs:include schemaLocation="NasMeasures.xsd"/>
	<xs:simpleType name="ActivatedIndicatorType">
		<xs:annotation>
			<xs:documentation>Indicates if the Special Purpose Indicator (SPI) has been activated. A transponder can be configured to provide this signal to aid in distinguishing between non-discretes.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ACTIVATED">
				<xs:annotation>
					<xs:documentation>SPI activated.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOT_ACTIVATED">
				<xs:annotation>
					<xs:documentation>SPI not activated.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="AddressQualifierType">
		<xs:annotation>
			<xs:documentation>Address Qualifier from CAT033 report.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ADSBICAO">
				<xs:annotation>
					<xs:documentation>ADS-B target with ICAO address</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ADSBSA">
				<xs:annotation>
					<xs:documentation>ADS-B target with self-assigned address</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BEACON">
				<xs:annotation>
					<xs:documentation>Fixed beacon</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TISBICAO">
				<xs:annotation>
					<xs:documentation>TIS-B target with ICAO address</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TISBTFI">
				<xs:annotation>
					<xs:documentation>TIS-B target with track file id</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VEHICLE">
				<xs:annotation>
					<xs:documentation>Surface vehicle</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="AdsbTrackIndicatorType">
		<xs:annotation>
			<xs:documentation>Indicates if Automatic Dependent Surveillance - Broadcast (ADS-B) contributed to track position.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ADSB">
				<xs:annotation>
					<xs:documentation>ADS-B contributed to track position.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOT_ADSB">
				<xs:annotation>
					<xs:documentation>ADS-B did not contribute to track position.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="AdsbValidationStatusType">
		<xs:annotation>
			<xs:documentation>SBS ADSB Lat/Lon validation status based on comparison with other sensor data.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="INVALID">
				<xs:annotation>
					<xs:documentation>ADS-B report determined to be invalid</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RESERVED">
				<xs:annotation>
					<xs:documentation>Reserved</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Validation status unknown</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VALID">
				<xs:annotation>
					<xs:documentation>ADS-B report determined to be valid</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="AlertFilterIndicatorType">
		<xs:annotation>
			<xs:documentation>Alert filter indicator</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="FILTERED">
				<xs:annotation>
					<xs:documentation>Filtered; Don't Highlight on Display</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HIGHLIGHT">
				<xs:annotation>
					<xs:documentation>Filtered; Highlight on Display</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNFILTERED">
				<xs:annotation>
					<xs:documentation>Not Filtered</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="AppliedindicatorType">
		<xs:annotation>
			<xs:documentation>Indicates whether or not ADS-B differential correction has been applied.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="APPLIED">
				<xs:annotation>
					<xs:documentation>ADS-B differential correction applied.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOT_APPLIED">
				<xs:annotation>
					<xs:documentation>ADS-B differential correction not applied.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="AsdexSystemModeType">
		<xs:annotation>
			<xs:documentation>Basic state of the Airport Surface Detection Equipment Model X (ASDE-X) or Airport Surface Surveillance Capability (ASSC) subsystem.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="MAINTENANCE">
				<xs:annotation>
					<xs:documentation>Indicates the system is in maintenance mode.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OPERATIONAL">
				<xs:annotation>
					<xs:documentation>Indicates the system is in operational mode.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CorruptIndicatorType">
		<xs:annotation>
			<xs:documentation>Indicates if replies were corrupted.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="CORRUPTED"/>
			<xs:enumeration value="NOT_CORRUPTED"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DownlinkFormatType">
		<xs:annotation>
			<xs:documentation>Downlink format of a mode S data block.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="DF0">
				<xs:annotation>
					<xs:documentation>Short air to air surveillance</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DF11">
				<xs:annotation>
					<xs:documentation>All-Call reply containing aircraft address</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DF17">
				<xs:annotation>
					<xs:documentation>Extended squitter</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DF18">
				<xs:annotation>
					<xs:documentation>TIS-B</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DF4">
				<xs:annotation>
					<xs:documentation>Surveillance, altitude reply</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DF5">
				<xs:annotation>
					<xs:documentation>Surveillance, Mode A identity reply</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EramWarningTypeType">
		<xs:annotation>
			<xs:documentation>ERAM warning types.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AMD_FREQUENCY">
				<xs:annotation>
					<xs:documentation>This enumerated value indicates a violation of the cool-down period before sending another amendment request.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MERGE_ANGLE">
				<xs:annotation>
					<xs:documentation>This enumerated value indicates a merge angle warning.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MODIFIED_FLT_DATA">
				<xs:annotation>
					<xs:documentation>This enumerated value indicates a warning the flight contains modified data that has not been displayed yet.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DATA_COMM">
				<xs:annotation>
					<xs:documentation>This enumerated value indicates a warning the flight contains DataComm warnings.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FilteredIndicatorType">
		<xs:annotation>
			<xs:documentation>Indicates whether the Taxiway Arrival Alert Filtered bit is set to true due to an MLAT critical fault.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="FILTERED">
				<xs:annotation>
					<xs:documentation>Filtered bit is set to true.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOT_FILTERED">
				<xs:annotation>
					<xs:documentation>Filtered bit is set to false.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FrozenTrackIndicatorType">
		<xs:annotation>
			<xs:documentation>For a frozen track, the radar returns have been interrupted and the position symbol and data label are frozen on the situation display at the last reported position.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="FROZEN">
				<xs:annotation>
					<xs:documentation>The track is frozen.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOT_FROZEN">
				<xs:annotation>
					<xs:documentation>The track is not frozen.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FusedHeightSourceType">
		<xs:annotation>
			<xs:documentation>This field indicates the fused height source.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ADSB">
				<xs:annotation>
					<xs:documentation>ADS-B height only</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GROUND">
				<xs:annotation>
					<xs:documentation>On-ground height only</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MODEC">
				<xs:annotation>
					<xs:documentation>Mode C height only</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MULTILAT">
				<xs:annotation>
					<xs:documentation>3D multilateration height only</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MULTIPLE">
				<xs:annotation>
					<xs:documentation>Multiple height sources</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NONE">
				<xs:annotation>
					<xs:documentation>No source</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FusedIndicatorType">
		<xs:annotation>
			<xs:documentation>Indicates if a particular source was fused in the creation of this message.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="FUSED">
				<xs:annotation>
					<xs:documentation>Fused bit was set.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOT_FUSED">
				<xs:annotation>
					<xs:documentation>Fused bit was not set.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="GpsMlatAgreementIndicatorType">
		<xs:annotation>
			<xs:documentation>Indicates if the GPS position is more than 100 feet from the multilaterated position indicator.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="GREATER_THAN_100_FEET">
				<xs:annotation>
					<xs:documentation>The GPS position is more than 100 feet from the multilaterated position indicator.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OK">
				<xs:annotation>
					<xs:documentation>The GPS position is not more than 100 feet from the multilaterated position indicator.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="GroundBitSetIndicatorType">
		<xs:annotation>
			<xs:documentation>Indicates if ground bit is set.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NOT_SET">
				<xs:annotation>
					<xs:documentation>Ground bit not set.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SET">
				<xs:annotation>
					<xs:documentation>Ground bit set.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MostReliableHeightType">
		<xs:annotation>
			<xs:documentation>Indicates if the reported altitude is 'barometric' from aircraft sensors or 'geometric' from multilateration.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="BAROMETRIC">
				<xs:annotation>
					<xs:documentation>Barometric (Mode C) Altitude</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GEOMETRIC">
				<xs:annotation>
					<xs:documentation>Geometric Altitude</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MultilaterationTypeType">
		<xs:annotation>
			<xs:documentation>Indicates the type of multilateration.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ATCRBS">
				<xs:annotation>
					<xs:documentation>ATCRBS multilateration</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MODE_S_OR_UAT">
				<xs:annotation>
					<xs:documentation>Mode S or UAT multilateration</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="NewTrackIndicatorType">
		<xs:annotation>
			<xs:documentation>Indicates if this is a new track.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NEW">
				<xs:annotation>
					<xs:documentation>This is a new track.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOT_NEW">
				<xs:annotation>
					<xs:documentation>This is not a new track.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PseudoTrackIndicatorType">
		<xs:annotation>
			<xs:documentation>A pseudo track is maintained and displayed based on flight plan information received from NAS rather than radar returns.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NOT_PSEUDO">
				<xs:annotation>
					<xs:documentation>This is not a pseudo track.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PSEUDO">
				<xs:annotation>
					<xs:documentation>This is a pseudo track.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ReferenceIndicatorType">
		<xs:annotation>
			<xs:documentation>Indicates if this is a reference transmitter report.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NOT_REFERENCE">
				<xs:annotation>
					<xs:documentation>This is not a reference transmitter report.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REFERENCE">
				<xs:annotation>
					<xs:documentation>This is a reference transmitter report.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SensitivityType">
		<xs:annotation>
			<xs:documentation>Sensitivity of the message.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="fb:CharacterStringType">
			<xs:pattern value="[A-Z]"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="StatusBitIndicatorsType">
		<xs:annotation>
			<xs:documentation>A list of ASDE-X status bit indicators.  Each type of indicator can have a value of 0, 1, or R (to indicate representation of the indicator was removed entirely since the previous message - used to support STDDS delta encoding).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="A9S_0">
				<xs:annotation>
					<xs:documentation>ASR9 source not fused</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="A9S_1">
				<xs:annotation>
					<xs:documentation>ASR9 source fused</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="A9S_R">
				<xs:annotation>
					<xs:documentation>A9S indicator removed</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AA_0">
				<xs:annotation>
					<xs:documentation>No SBS target association with track</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AA_1">
				<xs:annotation>
					<xs:documentation>SBS target associated with track</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AA_R">
				<xs:annotation>
					<xs:documentation>AA indicator removed</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AP_0">
				<xs:annotation>
					<xs:documentation>Coast in apron indicator is false</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AP_1">
				<xs:annotation>
					<xs:documentation>Coast in apron indicator is true</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AP_R">
				<xs:annotation>
					<xs:documentation>AP indicator removed</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AQ_0">
				<xs:annotation>
					<xs:documentation>Coast association question indicator is false</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AQ_1">
				<xs:annotation>
					<xs:documentation>Coast association question indicator is true</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AQ_R">
				<xs:annotation>
					<xs:documentation>AQ indicator removed</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AS_0">
				<xs:annotation>
					<xs:documentation>ADSB source fused is false</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AS_1">
				<xs:annotation>
					<xs:documentation>ADSB source fused is true</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AS_R">
				<xs:annotation>
					<xs:documentation>AS indicator removed</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DA_0">
				<xs:annotation>
					<xs:documentation>Duplicate discrete Mode A indicator is false</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DA_1">
				<xs:annotation>
					<xs:documentation>Duplicate discrete Mode A indicator is true</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DA_R">
				<xs:annotation>
					<xs:documentation>DA indicator removed</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DF_0">
				<xs:annotation>
					<xs:documentation>Duplicate flight id indicator is false</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DF_1">
				<xs:annotation>
					<xs:documentation>Duplicate flight id indicator is true</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DF_R">
				<xs:annotation>
					<xs:documentation>DF indicator removed</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DI_0">
				<xs:annotation>
					<xs:documentation>Do not display on ASDE-X DP</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DI_1">
				<xs:annotation>
					<xs:documentation>Display on ASDE-X DP</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DI_R">
				<xs:annotation>
					<xs:documentation>DI indicator removed</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LS_0">
