				</xs:annotation>
			</xs:element>
			<xs:element name="tracon" type="fb:CharacterStringType" minOccurs="0" maxOccurs="1" nillable="true">
				<xs:annotation>
					<xs:documentation>The TRACON that produced the data contained in the Message.</xs:documentation>
				</xs:annotation>
